'''Query from SQL table 'cars' '''

import sqlite3

#open file
DATABASE = "cars.db"


def execute_query(query, params=()):
    with sqlite3.connect(DATABASE) as db:
        #access columns by name, changing tuples into a dictionary type data
        db.row_factory = sqlite3.Row
        #initiate cursor, separates query from parameters
        cursor = db.cursor()
        cursor.execute(query, params)
        #fetch results
        results = cursor.fetchall()
        #get headers to print on top of data
        headers = results[0].keys()
        print(" | ".join(headers))
        print("-" * 30)
        #print data
        for row in results:
            print(" | ".join(str(row[column]) for column in headers))



